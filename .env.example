# ============================================================
# Stack เก่า: Docker Compose + Express (api/ + web/)
# รันด้วย: docker-compose up
# ============================================================

DB_NAME=expense_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change_this_to_a_random_secret_in_production
UPLOAD_MAX_SIZE_MB=50

# ============================================================
# Stack ใหม่: Next.js full-stack + Supabase (web/ เท่านั้น)
# สร้างไฟล์: web/.env.local  แล้วกรอกค่าด้านล่างนี้
# ดู web/.env.local.example สำหรับ template พร้อมคำอธิบาย
# ============================================================
