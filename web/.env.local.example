# ============================================================
# Next.js + Supabase Stack
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าให้ครบ
#   cp .env.local.example .env.local
# ============================================================

# ----------------------------------------------------------
# Database (Supabase Postgres — direct connection)
# Local:      postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: ดูได้ที่ Supabase Dashboard → Settings → Database → URI
# ----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ----------------------------------------------------------
# Supabase Project
# Local:      ดูจาก output ของ `supabase start`
# Production: Supabase Dashboard → Settings → API
# ----------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=su_public_key

# ----------------------------------------------------------
# JWT Secret — ใช้ sign/verify session cookie ของระบบนี้
# ต้องตรงกับ JWT Secret ของ Supabase project เดียวกัน
# Local:      ดูจาก output ของ `supabase start` (บรรทัด JWT secret)
# Production: Supabase Dashboard → Settings → API → JWT Secret
# ----------------------------------------------------------
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ----------------------------------------------------------
# Microsoft Entra ID (Azure AD) — login ด้วยบัญชีบริษัท
# สร้าง App Registration ใน Azure Portal ของ Thinknet
#   Platform: Web
#   Redirect URI: http://localhost:3000/api/auth/microsoft/callback
#   Permissions: openid, profile, email, User.Read
# ใช้ Tenant ID ของบริษัท (ไม่ใช้ "common")
# ----------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
MICROSOFT_ALLOWED_DOMAIN=thinknet.co.th

# ----------------------------------------------------------
# Corporate Auth API (optional — password login แบบเดิม)
# Endpoint ของ internal auth server สำหรับตรวจสอบ username/password
# Next.js จะ POST { username, password } ไปยัง URL นี้
# ถ้าไม่ใส่ จะตรวจ bcrypt จาก password_hash ในฐานข้อมูล
# ----------------------------------------------------------
# CORP_AUTH_API_URL=https://your-corp-auth-api/verify


NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
